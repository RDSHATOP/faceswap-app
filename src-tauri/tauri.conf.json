{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaceSwap",
  "version": "1.0.0",
  "identifier": "ru.zaloopa.faceswap",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://127.0.0.1:7100"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FaceSwap",
